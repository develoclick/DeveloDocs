{
  "name": "develodocs",
  "version": "0.1.0",
  "description": "High-performance PDF generation microservice from HTML/CSS templates",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:extreme": "tsx scripts/benchmark-extreme.ts"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.2",
    "@sparticuz/chromium": "^149.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.0",
    "handlebars": "^4.7.8",
    "p-limit": "^7.3.1",
    "pino": "^9.5.0",
    "playwright": "^1.48.2",
    "puppeteer-core": "^25.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.9.0",
    "autocannon": "^8.0.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
